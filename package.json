{
  "name": "libxmljs4",
  "author": "Jesse Stilwell <jesse.stilwell@gmail.com>",
  "contributors": [
    "marudor",
    "Jeff Smick",
    "Marco Rogers"
  ],
  "packageManager": "pnpm@9.15.9",
  "description": "libxml bindings for v8 javascript engine",
  "version": "1.2.0",
  "scripts": {
    "build": "node-gyp rebuild",
    "build:ts": "tsc && tsc -p tsconfig.esm.json",
    "prebuild": "prebuildify --napi",
    "install": "node-gyp-build",
    "test": "vitest run",
    "tsd": "tsd",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jstilwell/libxmljs4.git"
  },
  "bugs": {
    "url": "https://github.com/jstilwell/libxmljs4/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "license": "MIT",
  "tsd": {
    "directory": "."
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "files": [
    "dist",
    "prebuilds",
    "src",
    "vendor",
    "binding.gyp",
    "Makefile"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "vitest": "^4.1.10",
    "node-gyp": "^13.0.1",
    "prebuildify": "^6.0.1",
    "eslint": "^10.8.0",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "tsd": "^0.33.0",
    "typescript": "^7.0.2"
  }
}
